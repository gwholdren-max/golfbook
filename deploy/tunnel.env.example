# Copy to tunnel.env and fill in, then:
#   sudo systemctl restart teetime-ngrok@$USER
#
# Both values come from https://dashboard.ngrok.com after signing up:
#   authtoken  -> Getting Started > Your Authtoken
#   domain     -> Domains > Create Domain  (free plan includes one)
#
# The domain is the full hostname, no scheme:
NGROK_DOMAIN=your-name-here.ngrok-free.app
